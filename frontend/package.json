{
  "name": "haven-player",
  "version": "1.0.0",
  "description": "Haven Player - A modern video player application",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron-forge start",
    "package": "npm run build:prod && electron-forge package",
    "make": "npm run build:prod && electron-forge make",
    "dev": "concurrently \"npm run watch\" \"npm run start:dev\"",
    "start:dev": "cross-env NODE_ENV=development electron-forge start",
    "watch": "cross-env NODE_OPTIONS=--max-old-space-size=8192 webpack --config webpack.config.js --watch",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 webpack --config webpack.config.js",
    "build:prod": "node --max-old-space-size=14336 build-script.js",
    "build:analyze": "cross-env ANALYZE=true npm run build:prod",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "7.11.1",
    "@electron-forge/maker-deb": "7.11.1",
    "@electron-forge/maker-rpm": "7.11.1",
    "@electron-forge/maker-squirrel": "7.11.1",
    "@electron-forge/maker-zip": "7.11.1",
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "25.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@walletconnect/modal": "2.7.0",
    "autoprefixer": "10.5.0",
    "buffer": "6.0.3",
    "compression-webpack-plugin": "12.0.0",
    "concurrently": "9.2.1",
    "copy-webpack-plugin": "14.0.0",
    "cross-env": "10.1.0",
    "css-loader": "7.1.4",
    "electron": "42.0.1",
    "html-webpack-plugin": "5.6.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "livekit-client": "2.18.9",
    "process": "0.11.10",
    "style-loader": "4.0.0",
    "tailwindcss": "4.3.0",
    "terser-webpack-plugin": "5.6.0",
    "ts-jest": "29.4.9",
    "ts-loader": "9.5.7",
    "typescript": "6.0.3",
    "webpack": "5.106.2",
    "webpack-bundle-analyzer": "5.3.0",
    "webpack-cli": "7.0.2"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@ipld/car": "5.4.4",
    "@lit-protocol/auth": "8.2.3",
    "@lit-protocol/lit-client": "8.3.1",
    "@lit-protocol/networks": "8.4.1",
    "@mui/icons-material": "9.0.1",
    "@mui/material": "9.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.7.1",
    "@opentelemetry/core": "2.7.1",
    "@opentelemetry/instrumentation": "0.217.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-trace-base": "2.7.1",
    "@opentelemetry/semantic-conventions": "1.40.0",
    "@tanstack/react-virtual": "3.13.24",
    "axios": "1.16.0",
    "bufferutil": "4.1.0",
