{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom"],
    "allowJs": false
  },
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-net --allow-env main.ts",
    "dev": "deno run --allow-read --allow-write --allow-net --allow-env --watch main.ts",
    "check": "deno check main.ts",
    "test": "deno test --allow-read --allow-write --allow-net --allow-env"
  },
  "imports": {
    "@lit-protocol/lit-node-client": "npm:@lit-protocol/lit-node-client@^6.0.0",
    "@lit-protocol/constants": "npm:@lit-protocol/constants@^6.0.0",
    "@lit-protocol/types": "npm:@lit-protocol/types@^6.0.0"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  }
}
